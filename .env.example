# Copy to `.env` and fill in your keys. Keys are only read by the dev server /
# nginx proxy — they are never bundled into the browser JavaScript.

# https://newsapi.org/register
NEWSAPI_KEY=

# https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=

# https://developer.nytimes.com/get-started  (enable the "Article Search API")
NYT_API_KEY=
